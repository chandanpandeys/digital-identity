# Optional canonical URL override.
# On Vercel, the app automatically uses VERCEL_PROJECT_PRODUCTION_URL (the free stable *.vercel.app project domain).
# Set NEXT_PUBLIC_SITE_URL only if a custom domain is added later.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional server-side Gemini synthesis. Never prefix this key with NEXT_PUBLIC_.
# Without it, Ask still answers from public evidence and offers free browser AI.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.7-flash

# Optional official YouTube statistics, cached hourly. Without a key, dated
# public snapshots remain visible. Instagram/LinkedIn analytics are not scraped.
# YOUTUBE_API_KEY=
